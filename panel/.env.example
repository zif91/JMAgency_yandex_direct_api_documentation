# Flask Configuration
SECRET_KEY=your-secret-key-here

# Yandex OAuth Configuration
# Create an app at https://oauth.yandex.ru/
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
REDIRECT_URI=http://localhost:5000/oauth/yandex/callback

# Anthropic API (required for AI audit)
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Audit Agent Settings
# Default model: claude-haiku-4-5-20251022 (fastest, cheapest)
# Alternative: claude-sonnet-4-20250514 (better quality)
AUDIT_MODEL=claude-haiku-4-5-20251022
